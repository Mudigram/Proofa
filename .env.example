# =============================================================================
# Proofa Production & Development Environment Configuration
# =============================================================================

# ── Supabase Database & Auth ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share

# ── Nigerian Payments: Paystack (NGN) ─────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# ── International Payments: Bachs (USD) ──────────────────────────────────────
# Documentation: https://bachs.io
# Sandbox: https://sandbox-api.bachs.io | Production: https://api.bachs.io
BACHS_API_URL=https://api.bachs.io
BACHS_SECRET_KEY=sk_live_...
BACHS_WEBHOOK_SECRET=whsec_...

# ── Transactional & Customer Engagement Email: Sendly API ────────────────────
# Documentation: https://developer.sendlyai.com
SENDLY_API_URL=https://api.sendlyai.com/v1/messages
SENDLY_API_KEY=sk_live_...
SENDLY_FROM_EMAIL=Proofa <hello@proofa.ng>

# ── Admin Command Center ─────────────────────────────────────────────────────
ADMIN_SECRET_KEY=proofa_hq_2026

# ── Search Engine Optimization (GSC) ─────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
