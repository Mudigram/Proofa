# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & remotion outputs
/.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# PWA generated service workers
public/sw.js
public/sw.js.map
public/workbox-*.js
public/worker-*.js

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Remotion Video Project
video/node_modules/
video/out/
video/.remotion/
video/public/audio/
*.mp4
*.mov
*.wav
*.mp3
!public/videos/*.mp4
